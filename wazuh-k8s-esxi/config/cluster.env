#!/usr/bin/env bash
# =============================================================================
# Wazuh on Kubernetes (ESXi) — central configuration
# Supports: RED OS 8 | Astra Linux | Ubuntu 22.04
# Servers may be empty (no preinstalled packages) — install scripts bootstrap tools.
#
# Copy to /etc/wazuh-k8s/cluster.env on each node OR:
#   export WAZUH_K8S_ENV=/path/to/cluster.env
# =============================================================================

# --- Target OS (optional override; auto-detected from /etc/os-release) ---
# redos | astra | ubuntu
export TARGET_OS="${TARGET_OS:-}"
# On RED OS: permissive (default) | enforcing | disabled
export SELINUX_MODE="${SELINUX_MODE:-permissive}"
# Open K8s/Wazuh ports via firewalld/ufw when active
export FIREWALL_MANAGE="${FIREWALL_MANAGE:-true}"
# auto | package | binary  (RED OS defaults to binary containerd)
export CONTAINERD_INSTALL_METHOD="${CONTAINERD_INSTALL_METHOD:-auto}"
export ALLOW_UNSUPPORTED_OS="${ALLOW_UNSUPPORTED_OS:-false}"

# --- Cluster identity ---
export CLUSTER_NAME="${CLUSTER_NAME:-wazuh-prod}"
export WAZUH_NAMESPACE="${WAZUH_NAMESPACE:-wazuh}"
# Deb package epoch style (Ubuntu/Astra): 1.30.4-1.1
export K8S_VERSION="${K8S_VERSION:-1.30.4-1.1}"
# RPM pin for RED OS (semver often enough): 1.30.4
export K8S_VERSION_RPM="${K8S_VERSION_RPM:-1.30.4}"
export CONTAINERD_VERSION="${CONTAINERD_VERSION:-1.7.22}"
export RUNC_VERSION="${RUNC_VERSION:-1.1.14}"
export CNI_PLUGINS_VERSION="${CNI_PLUGINS_VERSION:-1.5.1}"
export UBUNTU_CODENAME="${UBUNTU_CODENAME:-jammy}"

# --- Node roles / hostnames (FQDN or short names resolvable via /etc/hosts or DNS) ---
export CP_HOST="${CP_HOST:-k8s-cp-01}"
export CP_IP="${CP_IP:-10.10.10.10}"
export WORKER_HOSTS="${WORKER_HOSTS:-k8s-worker-01 k8s-worker-02}"
export WORKER_IPS="${WORKER_IPS:-10.10.10.21 10.10.10.22}"
export INDEXER_HOSTS="${INDEXER_HOSTS:-k8s-indexer-01 k8s-indexer-02 k8s-indexer-03}"
export INDEXER_IPS="${INDEXER_IPS:-10.10.10.31 10.10.10.32 10.10.10.33}"

# --- kubeadm ---
export POD_CIDR="${POD_CIDR:-10.244.0.0/16}"
export SERVICE_CIDR="${SERVICE_CIDR:-10.96.0.0/12}"
export CNI_PLUGIN="${CNI_PLUGIN:-calico}"   # calico | cilium
export CONTROL_PLANE_ENDPOINT="${CONTROL_PLANE_ENDPOINT:-${CP_IP}:6443}"
export KUBEADM_TOKEN="${KUBEADM_TOKEN:-}"          # set after CP init
export KUBEADM_HASH="${KUBEADM_HASH:-}"            # sha256:... (prefix auto-added if missing)
export KUBEADM_CERT_KEY="${KUBEADM_CERT_KEY:-}"    # only for HA join as CP

# --- Disk devices (adjust per VM; empty = skip automated partitioning) ---
export OS_DISK="${OS_DISK:-/dev/sda}"
export CONTAINER_DISK="${CONTAINER_DISK:-/dev/sdb}"   # LVM → /var/lib/containerd
export LOG_DISK="${LOG_DISK:-}"                       # optional → /var/log
export INDEXER_DATA_DISK="${INDEXER_DATA_DISK:-/dev/sdc}"  # Indexer nodes only
export SWAP_ENABLED="${SWAP_ENABLED:-false}"

# --- Sizing (documentation defaults; scripts use for preflight min checks) ---
export MIN_DISK_GB_OS="${MIN_DISK_GB_OS:-80}"
export MIN_DISK_GB_CONTAINER="${MIN_DISK_GB_CONTAINER:-100}"
export MIN_DISK_GB_INDEXER_DATA="${MIN_DISK_GB_INDEXER_DATA:-1800}"
export MIN_RAM_GB_CP="${MIN_RAM_GB_CP:-8}"
export MIN_RAM_GB_WORKER="${MIN_RAM_GB_WORKER:-16}"
export MIN_RAM_GB_INDEXER="${MIN_RAM_GB_INDEXER:-32}"
export MIN_CPU_CP="${MIN_CPU_CP:-4}"
export MIN_CPU_WORKER="${MIN_CPU_WORKER:-8}"
export MIN_CPU_INDEXER="${MIN_CPU_INDEXER:-8}"

# --- Wazuh versions ---
export WAZUH_VERSION="${WAZUH_VERSION:-4.9.2}"
export WAZUH_HELM_REPO="${WAZUH_HELM_REPO:-https://wazuh.github.io/wazuh-kubernetes}"
export WAZUH_HELM_CHART="${WAZUH_HELM_CHART:-wazuh/wazuh}"
export WAZUH_K8S_GIT="${WAZUH_K8S_GIT:-https://github.com/wazuh/wazuh-kubernetes.git}"
export WAZUH_K8S_TAG="${WAZUH_K8S_TAG:-v4.9.2}"

# --- Agent / capacity assumptions ---
export AGENT_COUNT="${AGENT_COUNT:-200}"
export EVENTS_PER_AGENT_PER_DAY="${EVENTS_PER_AGENT_PER_DAY:-100000}"
export AVG_EVENT_SIZE_KB="${AVG_EVENT_SIZE_KB:-1.2}"
export INDEX_REPLICA_COUNT="${INDEX_REPLICA_COUNT:-1}"

# --- ISM / archiving ---
export HOT_RETENTION_DAYS="${HOT_RETENTION_DAYS:-14}"
export WARM_AFTER_DAYS="${WARM_AFTER_DAYS:-14}"
export COLD_SNAPSHOT_AFTER_DAYS="${COLD_SNAPSHOT_AFTER_DAYS:-90}"
export DELETE_AFTER_DAYS="${DELETE_AFTER_DAYS:-90}"
export SNAPSHOT_REPO_NAME="${SNAPSHOT_REPO_NAME:-wazuh-cold-archive}"
export SNAPSHOT_REPO_TYPE="${SNAPSHOT_REPO_TYPE:-fs}"   # fs | s3
export SNAPSHOT_REPO_PATH="${SNAPSHOT_REPO_PATH:-/mnt/wazuh-snapshots}"
export SNAPSHOT_S3_BUCKET="${SNAPSHOT_S3_BUCKET:-wazuh-cold-archive}"
export SNAPSHOT_S3_ENDPOINT="${SNAPSHOT_S3_ENDPOINT:-https://minio.storage.local:9000}"
export SNAPSHOT_S3_REGION="${SNAPSHOT_S3_REGION:-us-east-1}"
export SNAPSHOT_S3_ACCESS_KEY="${SNAPSHOT_S3_ACCESS_KEY:-}"
export SNAPSHOT_S3_SECRET_KEY="${SNAPSHOT_S3_SECRET_KEY:-}"

# --- TLS / credentials (CHANGE before production) ---
export INDEXER_ADMIN_USER="${INDEXER_ADMIN_USER:-admin}"
export INDEXER_ADMIN_PASSWORD="${INDEXER_ADMIN_PASSWORD:-ChangeMe_Indexer_Admin_ChangeMe}"
export DASHBOARD_PASSWORD="${DASHBOARD_PASSWORD:-ChangeMe_Dashboard_ChangeMe}"
export WAZUH_API_USER="${WAZUH_API_USER:-wazuh-wui}"
export WAZUH_API_PASSWORD="${WAZUH_API_PASSWORD:-ChangeMe_WazuhAPI_ChangeMe}"
export WAZUH_CLUSTER_KEY="${WAZUH_CLUSTER_KEY:-}"  # 32-char hex; auto-gen if empty

# --- Networking / ports ---
export WAZUH_AGENT_PORT="${WAZUH_AGENT_PORT:-1514}"
export WAZUH_ENROLLMENT_PORT="${WAZUH_ENROLLMENT_PORT:-1515}"
export WAZUH_API_PORT="${WAZUH_API_PORT:-55000}"
export INDEXER_HTTP_PORT="${INDEXER_HTTP_PORT:-9200}"
export INDEXER_TRANSPORT_PORT="${INDEXER_TRANSPORT_PORT:-9300}"
export DASHBOARD_PORT="${DASHBOARD_PORT:-443}"

# --- Logging ---
export LOG_DIR="${LOG_DIR:-/var/log/wazuh-k8s-install}"
export LOG_FILE="${LOG_FILE:-${LOG_DIR}/install-$(date +%Y%m%d).log}"

# --- Feature flags ---
export ENABLE_FILEBEAT_PIPELINE_CHECK="${ENABLE_FILEBEAT_PIPELINE_CHECK:-true}"
export DRY_RUN="${DRY_RUN:-false}"
